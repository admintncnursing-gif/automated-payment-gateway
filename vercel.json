{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/pay/:path*",
      "destination": "/paywall"
    },
    {
      "source": "/checkout/:path*",
      "destination": "/paywall"
    },
    {
      "source": "/test/:path*",
      "destination": "/paywall"
    },
    {
      "source": "/test",
      "destination": "/paywall"
    }
  ]
}
