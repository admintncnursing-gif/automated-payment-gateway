{
  "name": "archxpay",
  "version": "1.0.0",
  "description": "Merchant-reviewed automated UPI payment gateway with dynamic QR checkout, Gmail auto-verification, API access, and Supabase administration.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build-cloudflare.js",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=archxpay",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/admintncnursing-gif/automated-payment-gateway"
  },
  "keywords": [
    "upi",
    "payment-gateway",
    "india-payments",
    "fampay",
    "phonepe",
    "google-pay",
    "paytm",
    "qr-code",
    "auto-verification",
    "imap",
    "fintech",
    "zero-fee"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "imapflow": "^2.11.0",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "mailparser": "^3.14.3",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4"
  }
}
